// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`claudeArgs > a code run carries the allowlist, the refusal list, no setting sources, and the sandbox as --settings 1`] = `
[
  "-p",
  "--output-format",
  "json",
  "--model",
  "opus",
  "--permission-mode",
  "acceptEdits",
  "--allowedTools",
  "Read,Edit,Write,Glob,Grep,Bash(git status*),Bash(git diff*),Bash(git log*),Bash(git add*),Bash(git commit*),Bash(git checkout*),Bash(git restore*),Bash(pnpm install*),Bash(pnpm test*),Bash(pnpm typecheck*),Bash(pnpm build*),Bash(pnpm lint*),Bash(pnpm run *),Bash(pnpm -r *),Bash(npm ci*),Bash(npm install*),Bash(npm test*),Bash(npm run *),Bash(npx tsc*),Bash(npx eslint*),Bash(npx vitest*),Bash(npx next *),Bash(npx prettier*),Bash(yarn install*),Bash(yarn test*),Bash(yarn build*),Bash(yarn lint*),Bash(yarn run *)",
  "--disallowedTools",
  "Bash(git push*),Bash(git -c*),Bash(git config*),Bash(git remote*),Bash(curl*),Bash(wget*)",
  "--strict-mcp-config",
  "--mcp-config",
  "{"mcpServers":{}}",
  "--setting-sources",
  "",
  "--settings",
  "{"sandbox":{"enabled":true,"autoAllowBashIfSandboxed":true,"failIfUnavailable":true,"allowUnsandboxedCommands":false,"excludedCommands":[],"network":{"strictAllowlist":true,"allowedDomains":["registry.npmjs.org","registry.yarnpkg.com","github.com","objects.githubusercontent.com","codeload.github.com","fonts.googleapis.com","fonts.gstatic.com","pypi.org","files.pythonhosted.org","crates.io","static.crates.io","proxy.golang.org"],"deniedDomains":[],"allowLocalBinding":true},"filesystem":{"allowWrite":["~/Library/pnpm","~/Library/Caches/pnpm","~/.local/share/pnpm","~/.cache/pnpm","~/.npm"],"denyRead":["~/.harness/relay.pglite","~/.claude","~/.codex","~/.grok","~/.fx","~/.ssh","~/.aws","~/.config/gh","~/.harness/credentials.json","~/.harness/config.json","~/.harness/work.log","~/.claude.json","~/.netrc","~/.npmrc","~/.gitconfig"]},"credentials":{"files":[{"path":"~/.harness/relay.pglite","mode":"deny"},{"path":"~/.claude","mode":"deny"},{"path":"~/.codex","mode":"deny"},{"path":"~/.grok","mode":"deny"},{"path":"~/.fx","mode":"deny"},{"path":"~/.ssh","mode":"deny"},{"path":"~/.aws","mode":"deny"},{"path":"~/.config/gh","mode":"deny"},{"path":"~/.harness/credentials.json","mode":"deny"},{"path":"~/.harness/config.json","mode":"deny"},{"path":"~/.harness/work.log","mode":"deny"},{"path":"~/.claude.json","mode":"deny"},{"path":"~/.netrc","mode":"deny"},{"path":"~/.npmrc","mode":"deny"},{"path":"~/.gitconfig","mode":"deny"}]}},"permissions":{"blockReadsOutsideWorkingDirectories":true,"deny":["Read(~/.harness/relay.pglite/**)","Read(~/.claude/**)","Read(~/.codex/**)","Read(~/.grok/**)","Read(~/.fx/**)","Read(~/.ssh/**)","Read(~/.aws/**)","Read(~/.config/gh/**)","Read(~/.harness/credentials.json)","Read(~/.harness/config.json)","Read(~/.harness/work.log)","Read(~/.claude.json)","Read(~/.netrc)","Read(~/.npmrc)","Read(~/.gitconfig)","Edit(~/.harness/relay.pglite/**)","Edit(~/.claude/**)","Edit(~/.codex/**)","Edit(~/.grok/**)","Edit(~/.fx/**)","Edit(~/.ssh/**)","Edit(~/.aws/**)","Edit(~/.config/gh/**)","Edit(~/.harness/credentials.json)","Edit(~/.harness/config.json)","Edit(~/.harness/work.log)","Edit(~/.claude.json)","Edit(~/.netrc)","Edit(~/.npmrc)","Edit(~/.gitconfig)"]}}",
  "--max-turns",
  "40",
  "--",
  "# relay brief

Add hello.",
]
`;
