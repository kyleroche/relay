{
  "name": "@kyleroche/relay",
  "version": "0.3.0",
  "description": "relay: your coding-agent subscriptions (Claude Code, Codex, Grok) as one system. The CLI, the session hooks and the memory MCP server.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://relay.kyro.house",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyleroche/relay.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/kyleroche/relay/issues",
  "keywords": [
    "relay",
    "claude-code",
    "codex",
    "grok",
    "coding-agents",
    "mcp",
    "agent-memory",
    "github-actions",
    "self-hosted-runners",
    "cli"
  ],
  "bin": {
    "relay": "dist/relay.js",
    "relay-mcp": "dist/relay-mcp.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "relay": "../../bin/relay"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.126",
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-pgvector": "0.0.13",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/blob": "^2.8.2",
    "ai": "^7.0.153",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@relay/core": "workspace:*",
    "@relay/mcp": "workspace:*",
    "tsup": "^9.0.0"
  }
}
