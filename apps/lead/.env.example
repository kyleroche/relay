# Names only. Values belong in the Vercel project's environment (or .env.local for `eve dev`), never in a file here.

# relay: the hosted site whose MCP server the lead talks to, and the lead's own bearer token for it.
RELAY_SITE=
RELAY_TOKEN=

# The model, as a Vercel AI Gateway id. Read when the app is built.
RELAY_LEAD_MODEL=

# Who may wake the lead: whoever signs with this secret, which is the relay site. The same value is set on the site's
# project. At least 32 characters, for example `openssl rand -hex 32`. Unset or shorter = the wake route answers 503.
RELAY_LEAD_WAKE_SECRET=
