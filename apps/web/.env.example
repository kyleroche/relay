# Data source. "mock" (the default when DATABASE_URL is unset) serves the in-memory dataset.
RELAY_DATA=mock
# Postgres (Neon in production, PGlite locally). Setting this selects the db adapter.
DATABASE_URL=
# The team's Vercel Board, where tasks and workers live (db mode). On Vercel the deployment's own identity reaches it;
# locally, `vercel login`, or BOARD_URL for a board from `npx vb serve`. TEAM and NAME pick a board other than the
# default one; FROM lists the owners (comma-separated actor IDs) whose usage and run blocks the site believes.
RELAY_BOARD_TEAM=
RELAY_BOARD_NAME=
RELAY_BOARD_FROM=
BOARD_URL=
# Webhook signing secrets. Unset = that webhook answers 503.
GITHUB_WEBHOOK_SECRET=
VERCEL_WEBHOOK_SECRET=
# Baseline input context per call (tokens) that the usage page compares against.
RELAY_CTX_BASELINE=366000
# Public site origin used in metadata, sitemap and llms.txt.
NEXT_PUBLIC_SITE_URL=https://relay.kyro.house
# Paid sandbox runs (optional). A queued task that none of your workers can take is offered a run in a Vercel Sandbox;
# nothing starts or spends until a signed-in person approves a cap for that one task. Without RELAY_GATEWAY_TOKEN the
# offer is never shown. The site also needs its GitHub App (it mints a token for the task's one repository). The
# sandbox itself is created with the deployment's own OIDC token: nothing to set on Vercel, `vercel env pull` locally.
# The model gateway's key (Vercel AI Gateway). The sandbox's firewall adds it to requests; it never enters the sandbox.
RELAY_GATEWAY_TOKEN=
# The gateway endpoint Claude Code is pointed at. Unset = https://ai-gateway.vercel.sh/claude-code
RELAY_GATEWAY_URL=
# Minutes a task waits in the queue before a paid run is offered. Unset = 15
RELAY_CLOUD_AFTER_MINUTES=
# The most a person may approve for one run, in US dollars. Unset = 10
RELAY_CLOUD_MAX_CAP_USD=

# relay's lead (optional, apps/lead deployed as its own Vercel project). With its origin here, the site wakes it when a
# task fails, is held at the gate or reaches review. Unset = no lead.
RELAY_LEAD_URL=
# The secret the site signs each wake-up with (HMAC-SHA256); the same value is set on the lead's project. At least 32
# characters, for example `openssl rand -hex 32`. It is used for nothing else. Unset or shorter = no wake-up is sent.
RELAY_LEAD_WAKE_SECRET=
