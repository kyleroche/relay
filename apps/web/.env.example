# Data source. "mock" (the default when DATABASE_URL is unset) serves the in-memory dataset.
RELAY_DATA=mock
# Postgres (Neon in production, PGlite locally). Setting this selects the db adapter.
DATABASE_URL=
# Webhook signing secrets. Unset = that webhook answers 503.
GITHUB_WEBHOOK_SECRET=
VERCEL_WEBHOOK_SECRET=
# Baseline input context per call (tokens) that the usage page compares against.
RELAY_CTX_BASELINE=366000
# Public site origin used in metadata, sitemap and llms.txt.
NEXT_PUBLIC_SITE_URL=https://harness.kyro.house
