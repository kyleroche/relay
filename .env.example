# relay web app (apps/web) and memory server. Names only; values live in Vercel project settings or a local .env
# that is never committed. See docs/HOSTING.md for where each one comes from.

# Postgres connection string. Neon in production (provisioned through the Vercel Marketplace); leave unset locally
# to run on embedded PGlite.
DATABASE_URL=

# Vercel AI Gateway key: embeddings for memory search and the optional pay-per-token overflow lane.
AI_GATEWAY_API_KEY=

# Shared secret for the GitHub webhook (org or repo) that feeds issues, PRs, labels and the usage comments.
GITHUB_WEBHOOK_SECRET=

# Secret for the Vercel deployment webhook that feeds preview.ready and deploy events.
VERCEL_WEBHOOK_SECRET=

# Public base URL of the deployed app, e.g. https://relay.example.com (used in links and webhook self-checks).
RELAY_PUBLIC_URL=

# Bearer token the HTTP memory server requires from cloud agents and runners that call it over the network.
# It grants every scope. Scoped tokens come from `relay token create` (tokens table) or, without a database,
# RELAY_API_TOKENS in the form token:scope,scope;token2:scope.
RELAY_MEMORY_TOKEN=
RELAY_API_TOKENS=

# Data mode for the web app: db (DATABASE_URL, or the embedded PGlite file when unset) or mock. Unset means db when
# DATABASE_URL is set, else mock. RELAY_PGLITE_FILE overrides the PGlite path ($RELAY_HOME/relay.pglite).
RELAY_DATA=
RELAY_PGLITE_FILE=
# 1 lets /api/v1 reads and the public MCP tools answer without a token (default: only in mock mode).
RELAY_PUBLIC_READ=

# Secret Vercel sends as a bearer to /api/cron/assets-expire (daily retention sweep, apps/web/vercel.json).
CRON_SECRET=

# GitHub token (fine-grained, issues:write on the managed repos) for asset comments, reopening rejected issues, and
# reading the RELAY_ALLOWED_SENDERS repo variable. Unset means no comments are posted.
GITHUB_APP_TOKEN=
GITHUB_TOKEN=
# Comma-separated logins whose usage comments count towards the ledger (else the repo variable, else everyone).
RELAY_ALLOWED_SENDERS=

# Who the web app's approve/reject clicks are attributed to until sign-in lands (default human:web).
RELAY_REVIEWER=
# Optional JSON array of plan meters for the header: [{"id","label","subscription","percentUsed","resetsAt"}].
RELAY_PLAN_METERS=

# Asset library (docs/ASSETS.md). Private Vercel Blob store for asset bytes; unset means a local folder under
# $RELAY_HOME/assets. The public store is only needed for `relay asset publish`.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
# HMAC secret for local-store signed URLs; unset means a key file generated under $RELAY_HOME/assets/.signing-key.
RELAY_ASSET_SIGNING_KEY=
# Days before rejected and superseded asset versions are reclaimed by `relay asset expire` (default 30).
RELAY_ASSET_RETENTION_DAYS=
