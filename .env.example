# relay web app (apps/web) and memory server. Names only; values live in Vercel project settings or a local .env
# that is never committed. See docs/HOSTING.md for where each one comes from.

# Postgres connection string. Neon in production (provisioned through the Vercel Marketplace); leave unset locally
# to run on embedded PGlite.
DATABASE_URL=

# Vercel AI Gateway key: embeddings for memory search and the optional pay-per-token overflow lane.
AI_GATEWAY_API_KEY=

# Shared secret for the GitHub webhook (org or repo) that feeds issues, PRs, labels and the usage comments.
GITHUB_WEBHOOK_SECRET=

# Secret for the Vercel deployment webhook that feeds preview.ready and deploy events.
VERCEL_WEBHOOK_SECRET=

# Public base URL of the deployed app, e.g. https://relay.example.com (used in links and webhook self-checks).
RELAY_PUBLIC_URL=

# Bearer token the HTTP memory server requires from cloud agents and runners that call it over the network.
RELAY_MEMORY_TOKEN=

# Asset library (docs/ASSETS.md). Private Vercel Blob store for asset bytes; unset means a local folder under
# $RELAY_HOME/assets. The public store is only needed for `relay asset publish`.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
# HMAC secret for local-store signed URLs; unset means a key file generated under $RELAY_HOME/assets/.signing-key.
RELAY_ASSET_SIGNING_KEY=
# Days before rejected and superseded asset versions are reclaimed by `relay asset expire` (default 30).
RELAY_ASSET_RETENTION_DAYS=
